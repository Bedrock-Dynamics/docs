{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bedrock Dynamics",
  "appearance": {
    "default": "dark"
  },
  "colors": {
    "primary": "#c6ac89",
    "light": "#8a6d42",
    "dark": "#c6ac89"
  },
  "background": {
    "color": {
      "dark": "#1a1816"
    }
  },
  "favicon": "/favicon.png",
  "banner": {
    "content": "roz is now open source (research preview). Substrate is in closed beta.",
    "url": "https://github.com/BedrockDynamics/roz-oss"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Platform",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "architecture"
            ]
          }
        ]
      },
      {
        "tab": "Substrate",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "substrate/introduction",
              "substrate/installation",
              "substrate/quickstart"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "substrate/features/simulation",
              "substrate/features/ai-assistant",
              "substrate/features/3d-viewer",
              "substrate/features/telemetry",
              "substrate/features/flight-review",
              "substrate/features/scene-authoring",
              "substrate/features/code-editor"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "substrate/guides/connect-robot",
              "substrate/guides/record-replay",
              "substrate/guides/custom-models"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "substrate/reference/ai-tools",
              "substrate/reference/sim-mcp-server",
              "substrate/reference/flight-modes",
              "substrate/reference/coordinate-frames",
              "substrate/reference/docker-image",
              "substrate/reference/keyboard-shortcuts",
              "substrate/reference/supported-platforms",
              "substrate/reference/architecture"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "substrate/troubleshooting",
              "substrate/changelog",
              "substrate/roadmap"
            ]
          }
        ]
      },
      {
        "tab": "roz",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["roz/introduction", "roz/installation", "roz/quickstart"]
          },
          {
            "group": "Concepts",
            "pages": [
              "roz/concepts/two-control-paths",
              "roz/concepts/channel-interface",
              "roz/concepts/wasm-controllers",
              "roz/concepts/safety-architecture",
              "roz/concepts/agent-modes"
            ]
          },
          {
            "group": "Robots",
            "pages": [
              "roz/robots/manipulator",
              "roz/robots/drone-px4",
              "roz/robots/drone-ardupilot",
              "roz/robots/mobile-nav2"
            ]
          },
          {
            "group": "Deployment",
            "pages": [
              "roz/deployment/local-mode",
              "roz/deployment/self-hosting",
              "roz/deployment/cloud",
              "roz/deployment/edge"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "roz/reference/architecture",
              "roz/reference/cli-commands",
              "roz/reference/channel-manifests",
              "roz/reference/mcp-tools",
              "roz/reference/rest-api",
              "roz/reference/grpc-api",
              "roz/reference/configuration"
            ]
          },
          {
            "group": "Contributing",
            "pages": [
              "roz/contributing/development-setup",
              "roz/contributing/architecture-guide",
              "roz/contributing/testing-guide"
            ]
          },
          {
            "group": "Support",
            "pages": ["roz/troubleshooting", "roz/roadmap"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://bedrockdynamics.studio",
          "icon": "/logo/icons/globe.svg"
        },
        {
          "anchor": "GitHub (roz)",
          "href": "https://github.com/BedrockDynamics/roz-oss",
          "icon": "/logo/icons/globe.svg"
        },
        {
          "anchor": "Coming Soon",
          "href": "https://bedrockdynamics.studio",
          "icon": "/logo/icons/clock.svg"
        },
        {
          "anchor": "Docker Hub",
          "href": "https://hub.docker.com/u/bedrockdynamics",
          "icon": "/logo/icons/box.svg"
        },
        {
          "anchor": "Hugging Face",
          "href": "https://huggingface.co/Bedrock-Dynamics",
          "icon": "/logo/icons/huggingface.svg"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Discord",
